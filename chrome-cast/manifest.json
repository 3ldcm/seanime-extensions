{
  "id": "chrome-cast-test",
  "name": "Chrome Cast",
  "version": "1.1.0",
  "manifestURI": "https://raw.githubusercontent.com/3ldcm/seanime-extensions/refs/heads/main/chrome-cast/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Adds a Chromecast button to the Seanime video player",
  "author": "Bastien",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/3ldcm/seanime-extensions/refs/heads/main/chrome-cast/plugin.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "allow": {
        "unsafeFlags": [
          {
            "flag": "dom-script-manipulation",
            "reason": "Required to inject Chromecast controls into the Seanime player."
          }
        ]
      }
    }
  }
}
