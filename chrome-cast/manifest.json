{
  "id": "chrome-cast-test",
  "name": "Chrome Cast Test",
  "version": "2.4.4",
  "manifestURI": "https://raw.githubusercontent.com/3ldcm/seanime-extensions/refs/heads/main/chrome-cast/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Chromecast support for Seanime",
  "author": "Bastien",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/3ldcm/seanime-extensions/refs/heads/main/chrome-cast/plugin.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "allow": {
        "unsafeFlags": [
          {
            "flag": "dom-script-manipulation",
            "reason": "Required to use Google Cast from the Seanime UI."
          }
        ]
      }
    }
  }
}
